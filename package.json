{
  "name": "tokentriage",
  "version": "0.1.0",
  "description": "Explains why your LLM API bill is high — and how to cut it. Local-only log auditor with ranked findings and copy-paste fixes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tokentriage": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "pricing.json",
    "samples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "generate-sample": "tsx scripts/generate-sample.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "llm",
    "tokens",
    "cost",
    "openai",
    "anthropic",
    "prompt-caching",
    "observability",
    "helicone",
    "langfuse"
  ],
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
